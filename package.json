{
  "name": "arteli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@arteli/global-styles": "workspace:^",
    "@arteli/http": "workspace:^",
    "@arteli/icons": "workspace:^",
    "@arteli/state": "workspace:^",
    "@arteli/utils": "workspace:^",
    "@auth0/auth0-spa-js": "^2.1.3",
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@mui/lab": "^6.0.0-beta.16",
    "@mui/material": "^6.1.8",
    "@mui/x-charts": "^7.22.2",
    "@mui/x-data-grid-pro": "^7.22.0",
    "@mui/x-date-pickers": "^7.22.2",
    "@mui/x-license": "^7.23.2",
    "@segment/analytics-next": "^1.76.0",
    "@sentry/react": "^8.39.0",
    "@sentry/vite-plugin": "^2.22.6",
    "@tanstack/react-query": "^5.61.0",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.13",
    "formik": "^2.4.6",
    "msw": "^2.6.5",
    "query-string": "^9.1.1",
    "react": "^18.3.1",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "^18.3.1",
    "react-intl": "^7.0.1",
    "react-router-dom": "^6.28.0",
    "react-transition-group": "^4.4.5",
    "yup": "^1.4.0"
  },
  "scripts": {
    "preview": "vite preview --port 3000",
    "start": "vite",
    "build": "vite build",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "report": "vite preview --outDir coverage --port 3001",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint-fix": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 --fix",
    "serve": "vite preview",
    "typecheck": "tsc --noEmit",
    "generate-api": "(cd packages/arteli-generators && pnpm generate)",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run test --coverage",
    "extract": "formatjs extract 'src/**/*.ts*' 'idp/**/*.ts*' --ignore='**/*.d.ts' --out-file lang/en.json --id-interpolation-pattern '[sha512:contenthash:base64:6]' --additional-function-names 't' --out-file temp.json",
    "translate": "pnpm extract && formatjs compile 'temp.json' --out-file lang/en.json && rm temp.json",
    "get-core-swagger": "curl 'https://app-arteli-core-dev-eastus2.azurewebsites.net/swagger/v1/swagger.json' -H 'Authorization: Basic YXJ0ZWxpOiFyMGNrcyE=' > packages/arteli-generators/specs/core.swagger.json",
    "get-idp-swagger": "curl 'https://app-arteli-idp-dev-eastus2.azurewebsites.net/swagger/v1/swagger.json' -H 'Authorization: Basic YXJ0ZWxpOiFyMGNrcyE=' > packages/arteli-generators/specs/idp.swagger.json",
    "get-swagger": "pnpm get-core-swagger && pnpm get-idp-swagger && eslint packages/arteli-generators/specs/*.json --fix"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@formatjs/cli": "^6.3.11",
    "@tanstack/react-query-devtools": "^5.61.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.9.1",
    "@types/react": "^18.3.12",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "@types/react-dom": "^18.3.1",
    "@types/react-transition-group": "^4.4.11",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react-swc": "^3.7.1",
    "@vitest/coverage-v8": "^2.1.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-custom-alias": "^1.3.2",
    "eslint-plugin-formatjs": "^5.2.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "happy-dom": "^15.11.6",
    "prettier": "^3.3.3",
    "typescript": "5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^2.1.5"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "pnpm": {
    "overrides": {
      "braces@<3.0.3": ">=3.0.3",
      "ws@>=8.0.0 <8.17.1": ">=8.17.1",
      "micromatch@<4.0.8": ">=4.0.8",
      "dset@<3.1.4": ">=3.1.4",
      "path-to-regexp@>=4.0.0 <6.3.0": ">=6.3.0",
      "vite@>=5.3.0 <5.3.6": ">=5.3.6",
      "vite@>=5.3.0 <=5.3.5": ">=5.3.6",
      "rollup@>=4.0.0 <4.22.4": ">=4.22.4",
      "rollup@<3.29.5": ">=3.29.5"
    }
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
